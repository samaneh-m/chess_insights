APP_NAME=Chess Insights
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL connection. For host-based development, the defaults below
# (via localhost) work as-is. Inside Docker Compose, the app container
# connects to the `db` service instead — see docker-compose.yml, which
# overrides DATABASE_URL for the `app` service.
POSTGRES_DB=chess_insights
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chess:chess@localhost:5432/chess_insights

# Optional: only needed for higher Lichess API rate limits. Public game
# history endpoints work without it. Never commit a real token.
LICHESS_API_TOKEN=
